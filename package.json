{
  "name": "fudeba-solutionist",
  "displayName": "Fudeba Solutionist",
  "repository": {
    "type": "git",
    "url": "https://github.com/DamnedAngel/Fudeba-Solutionist.git"
  },
  "description": "A Visual Studio-style Solution Explorer for generic Microsoft Visual Studio solutions (.sln/.slnx), with specialized features for MSX projects. It works in pair with the MSX templates for Visual Studio and the ZOO framework.",
  "version": "0.0.1",
  "publisher": "damnedangel",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "solution explorer",
    "sln",
    "slnx",
    "vcxproj",
    "msbuild",
    "msx",
    "makefile project"
  ],
  "icon": "media/icon.png",
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx",
    "onView:fudebaSolutionist.tree",
    "onCommand:fudebaSolutionist.newProject"
  ],
  "extensionKind": [
    "workspace"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:vscode": "node test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "mocha": "^10.8.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fudebaSolutionist",
          "title": "Fudeba Solutionist",
          "icon": "media/sln.svg"
        }
      ]
    },
    "views": {
      "fudebaSolutionist": [
        {
          "id": "fudebaSolutionist.tree",
          "name": "Fudeba Solutionist",
          "icon": "media/sln.svg",
          "contextualTitle": "Fudeba Solutionist"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fudebaSolutionist.tree",
        "contents": "No solution found in this folder.\n[Create a New Solution...](command:fudebaSolutionist.newSolution)\n[Open Solution...](command:fudebaSolutionist.openSolution)\n[New Project from Template...](command:fudebaSolutionist.newProject)",
        "when": "!fudebaSolutionist.hasSolution"
      }
    ],
    "commands": [
      {
        "command": "fudebaSolutionist.newSolution",
        "title": "Create a New Solution...",
        "category": "Solution Explorer",
        "icon": "$(new-folder)"
      },
      {
        "command": "fudebaSolutionist.openSolution",
        "title": "Open Solution...",
        "category": "Solution Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fudebaSolutionist.refresh",
        "title": "Refresh",
        "category": "Solution Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "fudebaSolutionist.selectConfiguration",
        "title": "Select Solution Configuration...",
        "category": "Solution Explorer",
        "icon": "$(settings-gear)"
      },
      {
        "command": "fudebaSolutionist.newProject",
        "title": "New Project from Template...",
        "category": "Solution Explorer",
        "icon": "$(add)"
      },
      {
        "command": "fudebaSolutionist.importTemplate",
        "title": "Import Project Template (.zip)...",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.buildSolution",
        "title": "Build Solution",
        "category": "Solution Explorer",
        "icon": "$(play)"
      },
      {
        "command": "fudebaSolutionist.rebuildSolution",
        "title": "Rebuild Solution",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.cleanSolution",
        "title": "Clean Solution",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.cancelBuild",
        "title": "Cancel Build",
        "category": "Solution Explorer",
        "icon": "$(debug-stop)"
      },
      {
        "command": "fudebaSolutionist.build",
        "title": "Build",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.buildOnly",
        "title": "Build (Without Dependencies)",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.rebuild",
        "title": "Rebuild",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.clean",
        "title": "Clean",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.buildStartup",
        "title": "Build Startup Project",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.setStartup",
        "title": "Set as Startup Project",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.editDependencies",
        "title": "Project Dependencies...",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.removeProject",
        "title": "Remove from Solution...",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.about",
        "title": "About Fudeba Solutionist",
        "category": "Solution Explorer",
        "icon": "$(info)"
      },
      {
        "command": "fudebaSolutionist.projectProperties",
        "title": "MSX Project Settings...",
        "category": "Solution Explorer",
        "icon": "$(settings-gear)"
      },
      {
        "command": "fudebaSolutionist.removeDependency",
        "title": "Remove Dependency",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.showBuildOrder",
        "title": "Show Build Order",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.editAction",
        "title": "Edit Build Action...",
        "category": "Solution Explorer",
        "icon": "$(edit)"
      },
      {
        "command": "fudebaSolutionist.runAction",
        "title": "Run This Action",
        "category": "Solution Explorer",
        "icon": "$(play)"
      },
      {
        "command": "fudebaSolutionist.openProjectFile",
        "title": "Open Project File",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.newFilter",
        "title": "New Filter...",
        "category": "Solution Explorer",
        "icon": "$(new-folder)"
      },
      {
        "command": "fudebaSolutionist.renameFilter",
        "title": "Rename Filter...",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.deleteFilter",
        "title": "Delete Filter",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.addExistingFile",
        "title": "Add Existing File...",
        "category": "Solution Explorer",
        "icon": "$(file-add)"
      },
      {
        "command": "fudebaSolutionist.removeFromProject",
        "title": "Remove from Project",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.copyPath",
        "title": "Copy Path",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.chooseIconTheme",
        "title": "Choose Icon Theme...",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.setIcon",
        "title": "Set Icon...",
        "category": "Solution Explorer"
      },
      {
        "command": "fudebaSolutionist.reloadIcons",
        "title": "Reload Icons",
        "category": "Solution Explorer"
      }
    ],
    "taskDefinitions": [
      {
        "type": "fudebaSolutionist",
        "required": [
          "project",
          "action"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "fudebaSolutionist.removeProject",
        "key": "delete",
        "when": "focusedView == fudebaSolutionist.tree && listFocus && !inputFocus && viewItem =~ /^project/"
      },
      {
        "command": "fudebaSolutionist.buildSolution",
        "key": "ctrl+shift+\\",
        "when": "fudebaSolutionist.hasSolution && !fudebaSolutionist.building"
      },
      {
        "command": "fudebaSolutionist.buildSolution",
        "key": "ctrl+shift+oem_102",
        "when": "fudebaSolutionist.hasSolution && !fudebaSolutionist.building"
      },
      {
        "command": "fudebaSolutionist.rebuildSolution",
        "key": "ctrl+shift+b",
        "when": "fudebaSolutionist.hasSolution && !fudebaSolutionist.building"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fudebaSolutionist.about",
          "when": "view == fudebaSolutionist.tree",
          "group": "9_about@1"
        },
        {
          "command": "fudebaSolutionist.buildSolution",
          "when": "view == fudebaSolutionist.tree && fudebaSolutionist.hasSolution && !fudebaSolutionist.building",
          "group": "navigation@1"
        },
        {
          "command": "fudebaSolutionist.cancelBuild",
          "when": "view == fudebaSolutionist.tree && fudebaSolutionist.building",
          "group": "navigation@1"
        },
        {
          "command": "fudebaSolutionist.newProject",
          "when": "view == fudebaSolutionist.tree",
          "group": "navigation@2"
        },
        {
          "command": "fudebaSolutionist.selectConfiguration",
          "when": "view == fudebaSolutionist.tree && fudebaSolutionist.hasSolution",
          "group": "navigation@3"
        },
        {
          "command": "fudebaSolutionist.refresh",
          "when": "view == fudebaSolutionist.tree",
          "group": "navigation@4"
        },
        {
          "command": "fudebaSolutionist.openSolution",
          "when": "view == fudebaSolutionist.tree",
          "group": "1_solution@1"
        },
        {
          "command": "fudebaSolutionist.rebuildSolution",
          "when": "view == fudebaSolutionist.tree && fudebaSolutionist.hasSolution",
          "group": "2_build@2"
        },
        {
          "command": "fudebaSolutionist.cleanSolution",
          "when": "view == fudebaSolutionist.tree && fudebaSolutionist.hasSolution",
          "group": "2_build@3"
        },
        {
          "command": "fudebaSolutionist.showBuildOrder",
          "when": "view == fudebaSolutionist.tree && fudebaSolutionist.hasSolution",
          "group": "2_build@4"
        },
        {
          "command": "fudebaSolutionist.importTemplate",
          "when": "view == fudebaSolutionist.tree",
          "group": "3_templates@1"
        },
        {
          "command": "fudebaSolutionist.chooseIconTheme",
          "when": "view == fudebaSolutionist.tree",
          "group": "4_icons@1"
        },
        {
          "command": "fudebaSolutionist.newSolution",
          "when": "view == fudebaSolutionist.tree",
          "group": "1_solution@0"
        }
      ],
      "view/item/context": [
        {
          "command": "fudebaSolutionist.buildSolution",
          "when": "viewItem == solution",
          "group": "1_build@1"
        },
        {
          "command": "fudebaSolutionist.rebuildSolution",
          "when": "viewItem == solution",
          "group": "1_build@2"
        },
        {
          "command": "fudebaSolutionist.cleanSolution",
          "when": "viewItem == solution",
          "group": "1_build@3"
        },
        {
          "command": "fudebaSolutionist.newProject",
          "when": "viewItem == solution",
          "group": "2_add@1"
        },
        {
          "command": "fudebaSolutionist.selectConfiguration",
          "when": "viewItem == solution",
          "group": "3_config@1"
        },
        {
          "command": "fudebaSolutionist.build",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "1_build@1"
        },
        {
          "command": "fudebaSolutionist.rebuild",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "1_build@2"
        },
        {
          "command": "fudebaSolutionist.clean",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "1_build@3"
        },
        {
          "command": "fudebaSolutionist.buildOnly",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "1_build@4"
        },
        {
          "command": "fudebaSolutionist.editDependencies",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "2_project@1"
        },
        {
          "command": "fudebaSolutionist.setStartup",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "2_project@2"
        },
        {
          "command": "fudebaSolutionist.removeProject",
          "when": "viewItem =~ /^project/",
          "group": "9_remove@1"
        },
        {
          "command": "fudebaSolutionist.projectProperties",
          "when": "viewItem =~ /\\.msx$/",
          "group": "inline@9"
        },
        {
          "command": "fudebaSolutionist.projectProperties",
          "when": "viewItem =~ /\\.msx$/",
          "group": "2_project@0"
        },
        {
          "command": "fudebaSolutionist.openProjectFile",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "2_project@3"
        },
        {
          "command": "fudebaSolutionist.newFilter",
          "when": "viewItem =~ /^project(\\.|$)/ || viewItem == filter",
          "group": "3_add@1"
        },
        {
          "command": "fudebaSolutionist.addExistingFile",
          "when": "viewItem =~ /^project(\\.|$)/ || viewItem == filter",
          "group": "3_add@2"
        },
        {
          "command": "fudebaSolutionist.revealInOS",
          "when": "viewItem =~ /^project(\\.|$)/ || viewItem == file || viewItem == solution",
          "group": "9_os@1"
        },
        {
          "command": "fudebaSolutionist.copyPath",
          "when": "viewItem =~ /^project(\\.|$)/ || viewItem == file || viewItem == solution",
          "group": "9_os@2"
        },
        {
          "command": "fudebaSolutionist.renameFilter",
          "when": "viewItem == filter",
          "group": "4_filter@1"
        },
        {
          "command": "fudebaSolutionist.deleteFilter",
          "when": "viewItem == filter",
          "group": "4_filter@2"
        },
        {
          "command": "fudebaSolutionist.removeFromProject",
          "when": "viewItem == file",
          "group": "4_file@1"
        },
        {
          "command": "fudebaSolutionist.editDependencies",
          "when": "viewItem == deps",
          "group": "1_dep@1"
        },
        {
          "command": "fudebaSolutionist.removeDependency",
          "when": "viewItem == dep",
          "group": "1_dep@1"
        },
        {
          "command": "fudebaSolutionist.editAction",
          "when": "viewItem == action",
          "group": "inline"
        },
        {
          "command": "fudebaSolutionist.runAction",
          "when": "viewItem == action",
          "group": "inline"
        },
        {
          "command": "fudebaSolutionist.editAction",
          "when": "viewItem == action",
          "group": "1_action@1"
        },
        {
          "command": "fudebaSolutionist.runAction",
          "when": "viewItem == action",
          "group": "1_action@2"
        },
        {
          "command": "fudebaSolutionist.build",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "inline@1"
        },
        {
          "command": "fudebaSolutionist.setIcon",
          "when": "viewItem =~ /^(solution|solutionFolder|project|projectMissing|actions|action|deps|filter|folder|file)/",
          "group": "9_icons@1"
        }
      ],
      "commandPalette": [
        {
          "command": "fudebaSolutionist.build",
          "when": "false"
        },
        {
          "command": "fudebaSolutionist.buildOnly",
          "when": "false"
        },
        {
          "command": "fudebaSolutionist.rebuild",
          "when": "false"
        },
        {
          "command": "fudebaSolutionist.clean",
          "when": "false"
        },
        {
          "command": "fudebaSolutionist.removeDependency",
          "when": "false"
        },
        {
          "command": "fudebaSolutionist.editAction",
          "when": "false"
        },
        {
          "command": "fudebaSolutionist.runAction",
          "when": "false"
        },
        {
          "command": "fudebaSolutionist.renameFilter",
          "when": "false"
        },
        {
          "command": "fudebaSolutionist.deleteFilter",
          "when": "false"
        },
        {
          "command": "fudebaSolutionist.removeFromProject",
          "when": "false"
        }
      ],
      "file/newFile": [
        {
          "command": "fudebaSolutionist.newSolution",
          "group": "solution"
        }
      ]
    },
    "configuration": {
      "title": "Solution Explorer",
      "properties": {
        "fudebaSolutionist.solution": {
          "type": "string",
          "default": "",
          "description": "Solution file to show (absolute, or relative to the workspace folder). Empty: pick from the .sln/.slnx files found in the workspace."
        },
        "fudebaSolutionist.dependencyStorage": {
          "type": "string",
          "enum": [
            "solution",
            "projectReference"
          ],
          "default": "solution",
          "description": "Where new project dependencies are written: the solution (like Visual Studio's Project Dependencies dialog) or a ProjectReference in the project file."
        },
        "fudebaSolutionist.stopOnError": {
          "type": "boolean",
          "default": true,
          "description": "Stop a solution build at the first project that fails."
        },
        "fudebaSolutionist.msbuildPath": {
          "type": "string",
          "default": "msbuild",
          "description": "MSBuild executable used for C++ (non-Makefile) projects. Windows only."
        },
        "fudebaSolutionist.templateFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra folders searched for project templates (.zip files with a .vstemplate, or unzipped template folders). The Visual Studio template folders in Documents are always searched."
        },
        "fudebaSolutionist.problemMatchers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Problem matchers applied to build output, e.g. [\"$gcc\"]."
        },
        "fudebaSolutionist.itemTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            ".c": "ClCompile",
            ".cpp": "ClCompile",
            ".h": "ClInclude",
            ".hpp": "ClInclude",
            ".txt": "Text",
            ".cs": "Compile"
          },
          "description": "MSBuild item type used when adding a file with a given extension to a project that lists its files (anything else is added as None)."
        },
        "fudebaSolutionist.echoCommand": {
          "type": "boolean",
          "default": true,
          "description": "Print each project command line under its Build started header."
        },
        "fudebaSolutionist.problems": {
          "type": "boolean",
          "default": true,
          "description": "Report errors and warnings found in the build output in the Problems panel, with explanations for cryptic SDAS/SDLD/SDCC messages."
        },
        "fudebaSolutionist.searchUrl": {
          "type": "string",
          "default": "https://www.google.com/search?q={query}",
          "description": "Web search opened by \"Search the web for this error\". {query} is replaced by a generic description of the error (names from your code are left out)."
        },
        "fudebaSolutionist.iconTheme": {
          "type": "string",
          "enum": [
            "vs",
            "codicons",
            "folder"
          ],
          "enumDescriptions": [
            "Visual Studio style icons built into the extension.",
            "VS Code's own icons (codicons).",
            "Icons found by name in fudebaSolutionist.iconFolder (e.g. your copy of the Visual Studio Image Library); icons not found there use the built-in set."
          ],
          "default": "vs",
          "description": "Icon set of the Solution Explorer. Changes apply immediately."
        },
        "fudebaSolutionist.iconFolder": {
          "type": "string",
          "default": "",
          "description": "Folder searched (recursively) for SVG/PNG icons when iconTheme is \"folder\". Files are matched by name (Solution_16x.svg, CPPProjectNode_16x.svg, Folder_16x.svg ...); subfolders named light/dark supply theme variants. ~ and ${workspaceFolder} are expanded."
        },
        "fudebaSolutionist.icons": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "light": {
                    "type": "string"
                  },
                  "dark": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "default": {},
          "markdownDescription": "Override single icons. Keys: `solution`, `solutionFolder`, `project.cpp`, `project.makefile`, `project.dotnet`, `project.shared`, `project.unknown`, `project.missing`, `folder`, `filter`, `file`, `file.c`, `file.h`, `file.asm`, `file.inc`, `file.zoo`, `file.missing`, `buildActions`, `action.build`, `action.rebuild`, `action.clean`, `dependencies`. A value is a codicon name (`\"tools\"`), an SVG/PNG path, or `{ \"light\": \"...\", \"dark\": \"...\" }`."
        },
        "fudebaSolutionist.sourceControl.icons": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Mark the files of the tree with their source control status (from VS Code's git support, so any git repository: GitHub and others): a padlock for checked in, a red check mark for changed, a green plus for new. The mark is drawn on the file's icon, so files under source control use the extension's own icons (the file icons setting `fileTheme` turns this off)."
        },
        "fudebaSolutionist.fileIcons": {
          "type": "string",
          "enum": [
            "mixed",
            "fileTheme",
            "vs"
          ],
          "enumDescriptions": [
            "C, H, A (.asm/.s) and I (.inc) files get white-sheet icons with a badge; other files use your VS Code file icon theme.",
            "Files use your VS Code file icon theme only.",
            "The badge icons above, and the generic sheet for every other file."
          ],
          "default": "mixed",
          "description": "Icons of the files inside projects."
        },
        "fudebaSolutionist.newSolutionFormat": {
          "type": "string",
          "enum": [
            "ask",
            "sln",
            "slnx"
          ],
          "default": "ask",
          "enumDescriptions": [
            "Ask every time.",
            "The classic .sln solution file.",
            "The newer XML .slnx solution file (Visual Studio 2022 17.13 and later)."
          ],
          "description": "File format of a solution created with \"Create a New Solution...\"."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "fudebaSolutionist.gettingStarted",
        "title": "Get started with Fudeba Solutionist",
        "description": "A Visual Studio-style Solution Explorer: solutions, projects, build actions and the MSX tools.",
        "steps": [
          {
            "id": "create",
            "title": "Create a solution",
            "description": "Make an empty solution in a folder of its own.\n[Create a New Solution...](command:fudebaSolutionist.newSolution)",
            "media": {
              "markdown": "media/walkthrough/create.md"
            },
            "completionEvents": [
              "onCommand:fudebaSolutionist.newSolution"
            ]
          },
          {
            "id": "project",
            "title": "Add a project from a template",
            "description": "Use the Visual Studio project templates, including the MSX ones.\n[New Project from Template...](command:fudebaSolutionist.newProject)",
            "media": {
              "markdown": "media/walkthrough/project.md"
            },
            "completionEvents": [
              "onCommand:fudebaSolutionist.newProject"
            ]
          },
          {
            "id": "open",
            "title": "Or open an existing solution",
            "description": "Any .sln or .slnx, written on Windows or Linux.\n[Open Solution...](command:fudebaSolutionist.openSolution)",
            "media": {
              "markdown": "media/walkthrough/open.md"
            },
            "completionEvents": [
              "onCommand:fudebaSolutionist.openSolution"
            ]
          },
          {
            "id": "build",
            "title": "Pick a configuration and build",
            "description": "Debug or Release is in the first row of the tree; build from a project or the whole solution.\n[Build Solution](command:fudebaSolutionist.buildSolution)",
            "media": {
              "markdown": "media/walkthrough/build.md"
            },
