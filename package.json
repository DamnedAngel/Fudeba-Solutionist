{
  "name": "sln-explorer",
  "displayName": "Fudeba Solutionist",
  "repository": { "type": "git", "url": "https://github.com/DamnedAngel/Fudeba-Solutionist.git" },
  "description": "A Visual Studio-style Solution Explorer: .sln/.slnx solutions, projects with filters, per-project build actions, project dependencies, and new projects from Visual Studio project templates.",
  "version": "0.0.1",
  "publisher": "damnedangel",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "solution explorer",
    "sln",
    "slnx",
    "vcxproj",
    "msbuild",
    "msx",
    "makefile project"
  ],
  "icon": "media/icon.png",
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx",
    "onView:slnExplorer.tree",
    "onCommand:slnExplorer.newProject"
  ],
  "extensionKind": [
    "workspace"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:vscode": "node test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "mocha": "^10.8.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "slnExplorer",
          "title": "Fudeba Solutionist",
          "icon": "media/sln.svg"
        }
      ]
    },
    "views": {
      "slnExplorer": [
        {
          "id": "slnExplorer.tree",
          "name": "Fudeba Solutionist",
          "icon": "media/sln.svg",
          "contextualTitle": "Fudeba Solutionist"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "slnExplorer.tree",
        "contents": "No solution found in this folder.\n[Open Solution...](command:slnExplorer.openSolution)\n[New Project from Template...](command:slnExplorer.newProject)",
        "when": "!slnExplorer.hasSolution"
      }
    ],
    "commands": [
      {
        "command": "slnExplorer.openSolution",
        "title": "Open Solution...",
        "category": "Solution Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "slnExplorer.refresh",
        "title": "Refresh",
        "category": "Solution Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "slnExplorer.selectConfiguration",
        "title": "Select Solution Configuration...",
        "category": "Solution Explorer",
        "icon": "$(settings-gear)"
      },
      {
        "command": "slnExplorer.newProject",
        "title": "New Project from Template...",
        "category": "Solution Explorer",
        "icon": "$(add)"
      },
      {
        "command": "slnExplorer.importTemplate",
        "title": "Import Project Template (.zip)...",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.buildSolution",
        "title": "Build Solution",
        "category": "Solution Explorer",
        "icon": "$(play)"
      },
      {
        "command": "slnExplorer.rebuildSolution",
        "title": "Rebuild Solution",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.cleanSolution",
        "title": "Clean Solution",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.cancelBuild",
        "title": "Cancel Build",
        "category": "Solution Explorer",
        "icon": "$(debug-stop)"
      },
      {
        "command": "slnExplorer.build",
        "title": "Build",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.buildOnly",
        "title": "Build (Without Dependencies)",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.rebuild",
        "title": "Rebuild",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.clean",
        "title": "Clean",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.buildStartup",
        "title": "Build Startup Project",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.setStartup",
        "title": "Set as Startup Project",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.editDependencies",
        "title": "Project Dependencies...",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.removeProject",
        "title": "Remove from Solution...",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.removeDependency",
        "title": "Remove Dependency",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.showBuildOrder",
        "title": "Show Build Order",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.editAction",
        "title": "Edit Build Action...",
        "category": "Solution Explorer",
        "icon": "$(edit)"
      },
      {
        "command": "slnExplorer.runAction",
        "title": "Run This Action",
        "category": "Solution Explorer",
        "icon": "$(play)"
      },
      {
        "command": "slnExplorer.openProjectFile",
        "title": "Open Project File",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.newFilter",
        "title": "New Filter...",
        "category": "Solution Explorer",
        "icon": "$(new-folder)"
      },
      {
        "command": "slnExplorer.renameFilter",
        "title": "Rename Filter...",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.deleteFilter",
        "title": "Delete Filter",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.addExistingFile",
        "title": "Add Existing File...",
        "category": "Solution Explorer",
        "icon": "$(file-add)"
      },
      {
        "command": "slnExplorer.removeFromProject",
        "title": "Remove from Project",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.copyPath",
        "title": "Copy Path",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.chooseIconTheme",
        "title": "Choose Icon Theme...",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.setIcon",
        "title": "Set Icon...",
        "category": "Solution Explorer"
      },
      {
        "command": "slnExplorer.reloadIcons",
        "title": "Reload Icons",
        "category": "Solution Explorer"
      }
    ],
    "taskDefinitions": [
      {
        "type": "slnExplorer",
        "required": [
          "project",
          "action"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "slnExplorer.removeProject",
        "key": "delete",
        "when": "focusedView == slnExplorer.tree && listFocus && !inputFocus && viewItem =~ /^project/"
      },
      {
        "command": "slnExplorer.buildSolution",
        "key": "ctrl+shift+\\",
        "when": "slnExplorer.hasSolution && !slnExplorer.building"
      },
      {
        "command": "slnExplorer.buildSolution",
        "key": "ctrl+shift+oem_102",
        "when": "slnExplorer.hasSolution && !slnExplorer.building"
      },
      {
        "command": "slnExplorer.rebuildSolution",
        "key": "ctrl+shift+b",
        "when": "slnExplorer.hasSolution && !slnExplorer.building"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "slnExplorer.buildSolution",
          "when": "view == slnExplorer.tree && slnExplorer.hasSolution && !slnExplorer.building",
          "group": "navigation@1"
        },
        {
          "command": "slnExplorer.cancelBuild",
          "when": "view == slnExplorer.tree && slnExplorer.building",
          "group": "navigation@1"
        },
        {
          "command": "slnExplorer.newProject",
          "when": "view == slnExplorer.tree",
          "group": "navigation@2"
        },
        {
          "command": "slnExplorer.selectConfiguration",
          "when": "view == slnExplorer.tree && slnExplorer.hasSolution",
          "group": "navigation@3"
        },
        {
          "command": "slnExplorer.refresh",
          "when": "view == slnExplorer.tree",
          "group": "navigation@4"
        },
        {
          "command": "slnExplorer.openSolution",
          "when": "view == slnExplorer.tree",
          "group": "1_solution@1"
        },
        {
          "command": "slnExplorer.rebuildSolution",
          "when": "view == slnExplorer.tree && slnExplorer.hasSolution",
          "group": "2_build@2"
        },
        {
          "command": "slnExplorer.cleanSolution",
          "when": "view == slnExplorer.tree && slnExplorer.hasSolution",
          "group": "2_build@3"
        },
        {
          "command": "slnExplorer.showBuildOrder",
          "when": "view == slnExplorer.tree && slnExplorer.hasSolution",
          "group": "2_build@4"
        },
        {
          "command": "slnExplorer.importTemplate",
          "when": "view == slnExplorer.tree",
          "group": "3_templates@1"
        },
        {
          "command": "slnExplorer.chooseIconTheme",
          "when": "view == slnExplorer.tree",
          "group": "4_icons@1"
        }
      ],
      "view/item/context": [
        {
          "command": "slnExplorer.buildSolution",
          "when": "viewItem == solution",
          "group": "1_build@1"
        },
        {
          "command": "slnExplorer.rebuildSolution",
          "when": "viewItem == solution",
          "group": "1_build@2"
        },
        {
          "command": "slnExplorer.cleanSolution",
          "when": "viewItem == solution",
          "group": "1_build@3"
        },
        {
          "command": "slnExplorer.newProject",
          "when": "viewItem == solution",
          "group": "2_add@1"
        },
        {
          "command": "slnExplorer.selectConfiguration",
          "when": "viewItem == solution",
          "group": "3_config@1"
        },
        {
          "command": "slnExplorer.build",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "1_build@1"
        },
        {
          "command": "slnExplorer.rebuild",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "1_build@2"
        },
        {
          "command": "slnExplorer.clean",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "1_build@3"
        },
        {
          "command": "slnExplorer.buildOnly",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "1_build@4"
        },
        {
          "command": "slnExplorer.editDependencies",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "2_project@1"
        },
        {
          "command": "slnExplorer.setStartup",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "2_project@2"
        },
        {
          "command": "slnExplorer.removeProject",
          "when": "viewItem =~ /^project/",
          "group": "9_remove@1"
        },
        {
          "command": "slnExplorer.openProjectFile",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "2_project@3"
        },
        {
          "command": "slnExplorer.newFilter",
          "when": "viewItem =~ /^project(\\.|$)/ || viewItem == filter",
          "group": "3_add@1"
        },
        {
          "command": "slnExplorer.addExistingFile",
          "when": "viewItem =~ /^project(\\.|$)/ || viewItem == filter",
          "group": "3_add@2"
        },
        {
          "command": "slnExplorer.revealInOS",
          "when": "viewItem =~ /^project(\\.|$)/ || viewItem == file || viewItem == solution",
          "group": "9_os@1"
        },
        {
          "command": "slnExplorer.copyPath",
          "when": "viewItem =~ /^project(\\.|$)/ || viewItem == file || viewItem == solution",
          "group": "9_os@2"
        },
        {
          "command": "slnExplorer.renameFilter",
          "when": "viewItem == filter",
          "group": "4_filter@1"
        },
        {
          "command": "slnExplorer.deleteFilter",
          "when": "viewItem == filter",
          "group": "4_filter@2"
        },
        {
          "command": "slnExplorer.removeFromProject",
          "when": "viewItem == file",
          "group": "4_file@1"
        },
        {
          "command": "slnExplorer.editDependencies",
          "when": "viewItem == deps",
          "group": "1_dep@1"
        },
        {
          "command": "slnExplorer.removeDependency",
          "when": "viewItem == dep",
          "group": "1_dep@1"
        },
        {
          "command": "slnExplorer.editAction",
          "when": "viewItem == action",
          "group": "inline"
        },
        {
          "command": "slnExplorer.runAction",
          "when": "viewItem == action",
          "group": "inline"
        },
        {
          "command": "slnExplorer.editAction",
          "when": "viewItem == action",
          "group": "1_action@1"
        },
        {
          "command": "slnExplorer.runAction",
          "when": "viewItem == action",
          "group": "1_action@2"
        },
        {
          "command": "slnExplorer.build",
          "when": "viewItem =~ /^project(\\.|$)/",
          "group": "inline@1"
        },
        {
          "command": "slnExplorer.setIcon",
          "when": "viewItem =~ /^(solution|solutionFolder|project|projectMissing|actions|action|deps|filter|folder|file)/",
          "group": "9_icons@1"
        }
      ],
      "commandPalette": [
        {
          "command": "slnExplorer.build",
          "when": "false"
        },
        {
          "command": "slnExplorer.buildOnly",
          "when": "false"
        },
        {
          "command": "slnExplorer.rebuild",
          "when": "false"
        },
        {
          "command": "slnExplorer.clean",
          "when": "false"
        },
        {
          "command": "slnExplorer.removeDependency",
          "when": "false"
        },
        {
          "command": "slnExplorer.editAction",
          "when": "false"
        },
        {
          "command": "slnExplorer.runAction",
          "when": "false"
        },
        {
          "command": "slnExplorer.renameFilter",
          "when": "false"
        },
        {
          "command": "slnExplorer.deleteFilter",
          "when": "false"
        },
        {
          "command": "slnExplorer.removeFromProject",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Solution Explorer",
      "properties": {
        "slnExplorer.solution": {
          "type": "string",
          "default": "",
          "description": "Solution file to show (absolute, or relative to the workspace folder). Empty: pick from the .sln/.slnx files found in the workspace."
        },
        "slnExplorer.dependencyStorage": {
          "type": "string",
          "enum": [
            "solution",
            "projectReference"
          ],
          "default": "solution",
          "description": "Where new project dependencies are written: the solution (like Visual Studio's Project Dependencies dialog) or a ProjectReference in the project file."
        },
        "slnExplorer.stopOnError": {
          "type": "boolean",
          "default": true,
          "description": "Stop a solution build at the first project that fails."
        },
        "slnExplorer.msbuildPath": {
          "type": "string",
          "default": "msbuild",
          "description": "MSBuild executable used for C++ (non-Makefile) projects. Windows only."
        },
        "slnExplorer.templateFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra folders searched for project templates (.zip files with a .vstemplate, or unzipped template folders). The Visual Studio template folders in Documents are always searched."
        },
        "slnExplorer.problemMatchers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Problem matchers applied to build output, e.g. [\"$gcc\"]."
        },
        "slnExplorer.itemTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            ".c": "ClCompile",
            ".cpp": "ClCompile",
            ".h": "ClInclude",
            ".hpp": "ClInclude",
            ".txt": "Text",
            ".cs": "Compile"
          },
          "description": "MSBuild item type used when adding a file with a given extension to a project that lists its files (anything else is added as None)."
        },
        "slnExplorer.echoCommand": {
          "type": "boolean",
          "default": true,
          "description": "Print each project command line under its Build started header."
        },
        "slnExplorer.problems": {
          "type": "boolean",
          "default": true,
          "description": "Report errors and warnings found in the build output in the Problems panel, with explanations for cryptic SDAS/SDLD/SDCC messages."
        },
        "slnExplorer.searchUrl": {
          "type": "string",
          "default": "https://www.google.com/search?q={query}",
          "description": "Web search opened by \"Search the web for this error\". {query} is replaced by a generic description of the error (names from your code are left out)."
        },
        "slnExplorer.iconTheme": {
          "type": "string",
          "enum": [
            "vs",
            "codicons",
            "folder"
          ],
          "enumDescriptions": [
            "Visual Studio style icons built into the extension.",
            "VS Code's own icons (codicons).",
            "Icons found by name in slnExplorer.iconFolder (e.g. your copy of the Visual Studio Image Library); icons not found there use the built-in set."
          ],
          "default": "vs",
          "description": "Icon set of the Solution Explorer. Changes apply immediately."
        },
        "slnExplorer.iconFolder": {
          "type": "string",
          "default": "",
          "description": "Folder searched (recursively) for SVG/PNG icons when iconTheme is \"folder\". Files are matched by name (Solution_16x.svg, CPPProjectNode_16x.svg, Folder_16x.svg ...); subfolders named light/dark supply theme variants. ~ and ${workspaceFolder} are expanded."
        },
        "slnExplorer.icons": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "light": {
                    "type": "string"
                  },
                  "dark": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "default": {},
          "markdownDescription": "Override single icons. Keys: `solution`, `solutionFolder`, `project.cpp`, `project.makefile`, `project.dotnet`, `project.shared`, `project.unknown`, `project.missing`, `folder`, `filter`, `file`, `file.c`, `file.h`, `file.asm`, `file.inc`, `file.zoo`, `file.missing`, `buildActions`, `action.build`, `action.rebuild`, `action.clean`, `dependencies`. A value is a codicon name (`\"tools\"`), an SVG/PNG path, or `{ \"light\": \"...\", \"dark\": \"...\" }`."
        },
        "slnExplorer.fileIcons": {
          "type": "string",
          "enum": [
            "mixed",
            "fileTheme",
            "vs"
          ],
          "enumDescriptions": [
            "C, H, A (.asm/.s) and I (.inc) files get white-sheet icons with a badge; other files use your VS Code file icon theme.",
            "Files use your VS Code file icon theme only.",
            "The badge icons above, and the generic sheet for every other file."
          ],
          "default": "mixed",
          "description": "Icons of the files inside projects."
        }
      }
    }
  }
}
